# Copy to .env on the VPS and edit. Read by docker compose for interpolation only —
# the backend gets its TEXTROPY_* settings through the `environment:` block, not this file.
#
#   cp .env.example .env

# --- Required: the two public URLs ------------------------------------------------------
# Both are browser-facing. They must be the addresses a visitor's browser can reach, which
# is why neither can be a container name or an internal address.

# Where the API is published. Baked into the frontend bundle at build time, so changing it
# requires `docker compose up -d --build`, not a restart.
PUBLIC_API_URL=http://203.0.113.10:8000

# Where the UI is served from. Becomes the backend's CORS allowlist; a mismatch (a stray
# trailing slash, http vs https, www vs apex) blocks every request from the browser.
FRONTEND_ORIGIN=http://203.0.113.10:3000

# --- Published ports --------------------------------------------------------------------
# Set BIND_ADDRESS=127.0.0.1 if a proxy on the host will terminate TLS and forward.
BIND_ADDRESS=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000

# --- Backend tuning ---------------------------------------------------------------------
# eager preloads EAGER_TIERS at startup; lazy loads each model on first use (lower startup
# RAM, slow first request per tier).
MODEL_LOADING=eager
# JSON list. [1] = spaCy only, ~200MB. [1,2,3] = ~1.5-2GB resident and ~90s to ready.
EAGER_TIERS=[1]
LOG_LEVEL=INFO
# Server-side input cap in characters; 0 disables it. 20000 matches the frontend's block.
MAX_TEXT_CHARS=20000
# torch intra-op threads; 0 keeps torch's default. Pin to the box's core count on a small
# VPS to stop a single Tier 3 request from saturating every core.
TORCH_NUM_THREADS=0

# --- Container memory limits ------------------------------------------------------------
API_MEMORY_LIMIT=3g
FRONTEND_MEMORY_LIMIT=512m
